# Copy to .env and fill in your values
PORT=5000
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db-name>?appName=<app-name>
MONGODB_URI=mongodb+srv://gugigereAdmin:admin123@gugigere-cluster.knnqbmi.mongodb.net/stylisshnaari?appName=gugigere-cluster
JWT_SECRET=change_me_to_a_long_random_string
# Browser origins allowed by CORS — comma-separated if you're serving
# both the admin panel and the storefront (e.g. admin URL,storefront URL).
CLIENT_URL=http://localhost:5173

# Cloudinary — server-side credentials, never expose these to browsers.
# Grab from https://console.cloudinary.com → Dashboard.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Razorpay — Test Mode keys from https://dashboard.razorpay.com/app/keys
# KEY_ID is also exposed to the browser (via NEXT_PUBLIC_RAZORPAY_KEY_ID
# on the storefront), KEY_SECRET stays server-only.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Shiprocket — Settings > API > API User credentials in
# https://app.shiprocket.in/. PICKUP_LOCATION must match the nickname
# of a registered pickup address exactly (Settings > Pickup Addresses).
# SHIPROCKET_EMAIL=your-shiprocket-email@example.com
# SHIPROCKET_PASSWORD=your-shiprocket-password
# SHIPROCKET_PICKUP_LOCATION=Primary
